# ARTHunt Environment Configuration Template
# Copy this to .env for production or use config.js for local development

# Supabase Credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Gemini API Key (if using AI features)
VITE_GEMINI_API_KEY=your-gemini-api-key

# Note: Ensure these are also configured in your hosting provider (Vercel/Netlify)
